# Copy to .env — never commit real secrets.
NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://dispatcher:dispatcher@localhost:5440/dispatcher?schema=public

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated origins allowed by CORS (web admin).
CORS_ORIGINS=http://localhost:3000
