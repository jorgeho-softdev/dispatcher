# Copy to .env — never commit real secrets.
NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://dispatcher:dispatcher@localhost:5440/dispatcher?schema=public

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated origins allowed by CORS (web admin).
CORS_ORIGINS=http://localhost:3000

# Phase 2 — AI agent
REDIS_URL=redis://localhost:6380
# auto | claude | rules  (auto = claude when ANTHROPIC_API_KEY is set)
AI_STRATEGY=auto
# ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
# Simulated broker reply delay in ms
BROKER_SIM_DELAY_MS=4000
# Optional, only if Expo push "enhanced security" is enabled
# EXPO_ACCESS_TOKEN=

# Phase 3 — trip documents (S3-compatible). Local: SeaweedFS from docker-compose.
S3_ENDPOINT=http://localhost:9000
# Presigned URLs host for clients. Physical phone: http://<your-LAN-IP>:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=ca-central-1
S3_BUCKET=dispatcher-documents
S3_ACCESS_KEY_ID=dispatcher
S3_SECRET_ACCESS_KEY=dispatcher-secret
S3_FORCE_PATH_STYLE=true

# Phase 4 — public URL of the web admin (used in invitation links)
WEB_URL=http://localhost:3000
