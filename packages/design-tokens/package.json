{
  "name": "@dispatcher/design-tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Brand colors, typography, radii and spacing \u2014 the single source of truth for web and mobile. Edit src/tokens.ts.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./web-theme.css": "./generated/web-theme.css"
  },
  "files": [
    "dist",
    "generated"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean && node scripts/build-css.mjs",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch --onSuccess \"node scripts/build-css.mjs\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@dispatcher/tsconfig": "*",
    "tsup": "^8.5.1",
    "typescript": "5.9.3"
  }
}
